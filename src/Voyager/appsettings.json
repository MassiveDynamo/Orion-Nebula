{
  "DbConnection": "(Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=Voyager;Integrated Security=True;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Application Intent=ReadWrite;Multi Subnet Failover=False;Command Timeout=30)",
  "DataFolder": "D:\\Data\\Orion",
  "ShowProgress":  "True",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "D:/Logs/Voyager/log..json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 4194304,
          "retainedFileCountLimit": 6,
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "Voyager"
    }
  }


}